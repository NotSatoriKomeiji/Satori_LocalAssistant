{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satori",
  "version": "0.1.5",
  "identifier": "io.habitos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Satori",
        "width": 1160,
        "height": 800,
        "minWidth": 840,
        "minHeight": 640,
        "visible": false
      },
      {
        "label": "recommendation",
        "create": false,
        "title": "Satori · 时间推荐",
        "width": 480,
        "height": 350,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "tray",
        "create": false,
        "title": "Satori",
        "width": 480,
        "height": 350,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first adaptive desktop companion"
  }
}
