{
  "manifest_version": 3,
  "name": "Satori 快速词与常用网站",
  "version": "0.1.3",
  "description": "快速词与桌面版共用开关和词库，右下角点击输入；本地学习普通词句，跳过敏感输入。",
  "permissions": [
    "webNavigation",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Satori 快速词",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "key": "",
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "phrases.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
